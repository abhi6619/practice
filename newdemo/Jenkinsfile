pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "YOUR_DOCKERHUB_USERNAME/python-demo-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('1. Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/YOUR_ACTUAL_USERNAME/python-demo-app.git'
                )
            }
        }

        stage('2. Python Test') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate

                    pip install --upgrade pip
                    pip install -r requirements.txt

                    pytest -v
                '''
            }
        }

        stage('3. Code Scan') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=python-demo-app \
                          -Dsonar.projectName=python-demo-app \
                          -Dsonar.sources=. \
                          -Dsonar.python.version=3.12
                    '''
                }
            }
        }

        stage('4. Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                      -t ${DOCKER_IMAGE}:latest \
                      .
                '''
            }
        }

        stage('5. Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('6. Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                        docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin
                    '''
                }
            }
        }

        stage('7. Push Image') {
            steps {
                sh '''
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                '''
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo ' PIPELINE SUCCESSFUL'
            echo '======================================'
            echo "Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {
            echo '======================================'
            echo ' PIPELINE FAILED'
            echo '======================================'
        }

        always {
            sh 'docker logout || true'
        }
    }
}

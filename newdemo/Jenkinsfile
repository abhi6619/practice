pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "abhi6619/practice"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('1. Verify Workspace') {
            steps {
                sh '''
                    echo "======================================"
                    echo "WORKSPACE"
                    echo "======================================"

                    pwd

                    echo "======================================"
                    echo "FILES"
                    echo "======================================"

                    ls -la

                    echo "======================================"
                    echo "REQUIRED FILES"
                    echo "======================================"

                    test -f app.py
                    test -f test_app.py
                    test -f requirements.txt
                    test -f Dockerfile

                    echo "All required files are present."
                '''
            }
        }

        stage('2. Python Test') {
            steps {
                sh '''
                    echo "======================================"
                    echo "PYTHON TEST"
                    echo "======================================"

                    python3 --version

                    rm -rf venv

                    python3 -m venv venv

                    . venv/bin/activate

                    python -m pip install --upgrade pip

                    pip install -r requirements.txt

                    pytest -v
                '''
            }
        }

        stage('3. Code Scan') {
            steps {
                withSonarQubeEnv('sonarqube') {

                    sh '''
                        echo "======================================"
                        echo "SONARQUBE CODE SCAN"
                        echo "======================================"

                        sonar-scanner \
                          -Dsonar.projectKey=practice \
                          -Dsonar.projectName=practice \
                          -Dsonar.sources=. \
                          -Dsonar.python.version=3.12
                    '''
                }
            }
        }

        stage('4. Build Docker Image') {
            steps {
                sh '''
                    echo "======================================"
                    echo "DOCKER BUILD"
                    echo "======================================"

                    docker --version

                    docker build \
                      -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                      -t ${DOCKER_IMAGE}:latest \
                      .

                    echo "Docker image built successfully."

                    docker images | grep practice
                '''
            }
        }

        stage('5. Trivy Image Scan') {
            steps {
                sh '''
                    echo "======================================"
                    echo "TRIVY IMAGE SCAN"
                    echo "======================================"

                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('6. Docker Hub Login') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "======================================"
                        echo "DOCKER HUB LOGIN"
                        echo "======================================"

                        echo "$DOCKER_PASSWORD" | \
                        docker login \
                          --username "$DOCKER_USER" \
                          --password-stdin
                    '''
                }
            }
        }

        stage('7. Push Docker Image') {
            steps {
                sh '''
                    echo "======================================"
                    echo "PUSHING IMAGE"
                    echo "======================================"

                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}

                    docker push ${DOCKER_IMAGE}:latest

                    echo "======================================"
                    echo "IMAGE PUSHED SUCCESSFULLY"
                    echo "======================================"

                    echo "Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
                    echo "Image: ${DOCKER_IMAGE}:latest"
                '''
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "          PIPELINE SUCCESS"
            echo "======================================"

            echo "Docker Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
            echo "Docker Image: ${DOCKER_IMAGE}:latest"
        }

        failure {
            echo "======================================"
            echo "          PIPELINE FAILED"
            echo "======================================"

            echo "Check the failed stage above."
        }

        always {
            sh '''
                docker logout || true
            '''
        }
    }
}

pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "abhi6619/practice"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('1. Verify Workspace') {
            steps {
                sh '''
                    echo "Checking application directory..."

                    test -d newdemo

                    cd newdemo

                    echo "Application files:"
                    ls -la

                    test -f app.py
                    test -f test_app.py
                    test -f requirements.txt
                    test -f Dockerfile

                    echo "All required files found."
                '''
            }
        }

        stage('2. Python Test') {
            steps {
                sh '''
                    cd newdemo

                    echo "Python version:"
                    python3 --version

                    rm -rf venv

                    python3 -m venv venv

                    . venv/bin/activate

                    python -m pip install --upgrade pip

                    pip install -r requirements.txt

                    pytest -v
                '''
            }
        }

        stage('3. Code Scan') {
    steps {
        script {
            def scannerHome = tool 'sonar-scanner'

            withSonarQubeEnv('sonarqube') {

                sh """
                    echo "======================================"
                    echo "SONARQUBE SCAN"
                    echo "======================================"

                    echo "Scanner location:"
                    ${scannerHome}/bin/sonar-scanner --version

                    ${scannerHome}/bin/sonar-scanner \
                      -Dsonar.projectKey=practice \
                      -Dsonar.projectName=practice \
                      -Dsonar.sources=. \
                      -Dsonar.python.version=3.12
                """
            }
        }
    }
}

        stage('4. Build Docker Image') {
            steps {
                sh '''
                    cd newdemo

                    docker build \
                      -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                      -t ${DOCKER_IMAGE}:latest \
                      .
                '''
            }
        }

        stage('5. Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('6. Docker Hub Login') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                        docker login \
                        --username "$DOCKER_USER" \
                        --password-stdin
                    '''
                }
            }
        }

        stage('7. Push Docker Image') {
            steps {
                sh '''
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}

                    docker push ${DOCKER_IMAGE}:latest

                    echo "Image pushed successfully:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
                    echo "${DOCKER_IMAGE}:latest"
                '''
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "       PIPELINE SUCCESSFUL"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "          PIPELINE FAILED"
            echo "======================================"
        }

        always {
            sh 'docker logout || true'
        }
    }
}
